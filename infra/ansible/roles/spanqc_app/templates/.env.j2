# ==============================================================================
# SpanQC Production Environment (Managed by Ansible)
# ==============================================================================

PORT={{ app_port }}
NODE_ENV={{ app_env }}
DATABASE_URL="{{ database_url }}"
PYTHON_SERVICE_URL="{{ python_service_url }}"
SPANQC_PYTHON_SERVICE_URL="{{ python_service_url }}"

NEXTAUTH_URL="http://{{ ansible_host }}"
AUTH_SECRET="{{ auth_secret }}"

ANTHROPIC_API_KEY="{{ anthropic_api_key }}"
SPANQC_MODEL="{{ spanqc_model }}"

RAZORPAY_KEY_ID="{{ razorpay_key_id }}"
RAZORPAY_KEY_SECRET="{{ razorpay_key_secret }}"
RAZORPAY_WEBHOOK_SECRET="{{ razorpay_webhook_secret }}"
NEXT_PUBLIC_RAZORPAY_KEY_ID="{{ next_public_razorpay_key_id }}"
ADMIN_EMAILS="{{ admin_emails }}"
SPANQC_INTERNAL_SERVICE_SECRET="{{ spanqc_internal_service_secret | default('') }}"
