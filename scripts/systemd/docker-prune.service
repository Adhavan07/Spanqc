[Unit]
Description=SpanQC Weekly Docker Cache and Unused Images Cleanup
Documentation=https://docs.docker.com/engine/reference/commandline/system_prune/
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Prune dangling and unused images older than 7 days, but NEVER remove volumes (database is safe)
ExecStart=/usr/bin/docker system prune -af --filter "until=168h"
StandardOutput=journal
StandardError=journal
