# ==============================================================================
# SpanQC Production Environment Configuration Template
# Copy this to .env on your EC2 instance before running `docker compose up -d`
# ==============================================================================

# NextAuth / Session Secret (generate with: openssl rand -hex 32)
AUTH_SECRET=generate_a_random_32_byte_hex_secret_here

# Public URL of the application (e.g. http://13.233.x.x or https://spanqc.com)
NEXTAUTH_URL=http://YOUR_EC2_PUBLIC_IP

# Database URL inside Docker container (persisted to volume spanqc_data)
DATABASE_URL="file:/app/data/dev.db"

# Internal Python Core Microservice URL
PYTHON_SERVICE_URL=http://core:8000

# Anthropic Claude API Key for Vision Extraction (Transcribing diagrams)
ANTHROPIC_API_KEY=sk-ant-api-key-here
SPANQC_MODEL=claude-sonnet-4-6

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Admin notification / allowlist
ADMIN_EMAILS=
