# ==============================================================================
# SPANQC Enterprise - Vendor & Cloud Deployment Configuration (.env)
# ==============================================================================
# Copy this file to .env before starting the application via Docker or Cloud Service:
#   cp .env.vendor.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=80
NEXTAUTH_URL="http://localhost" # Set to the vendor server's domain or public IP (e.g. https://qc.vendorcompany.com)

# Generate a strong 32-byte secret using: openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-32-byte-hex-string-for-session-encryption"

# Internal microservice communication between Next.js and Python Core
PYTHON_SERVICE_URL="http://core:8000"
SPANQC_PYTHON_SERVICE_URL="http://core:8000"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Built-in Docker PostgreSQL (Default - runs automatically in docker-compose)
DATABASE_URL="postgresql://spanqc:spanqc_secure_pass@db:5432/spanqc_prod?schema=public"

# Option B: AWS RDS PostgreSQL / Azure Database for PostgreSQL / Existing Corporate DB
# DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require"

# Optional: Direct URL for migrations if connection pooler (PgBouncer) is in use
# DIRECT_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>"

# ------------------------------------------------------------------------------
# 3. AI EXTRACTION & MULTIMODAL VISION MODEL
# ------------------------------------------------------------------------------
# Provide at least one API key for the AI schematic transcription engine:

# Anthropic Claude (Recommended: claude-sonnet-4-6 or claude-3-5-sonnet-latest)
ANTHROPIC_API_KEY=""
SPANQC_MODEL="claude-sonnet-4-6"

# Or AWS Bedrock (if running on AWS cloud)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"

# Or Azure OpenAI (if running on Azure cloud)
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT=""

# Or Google Gemini (Optional)
# GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. SCHEMATIC STORAGE (UPLOADS & AUDIT PACKAGES)
# ------------------------------------------------------------------------------
# By default, files are stored on a local Docker persistent volume (/app/storage).
# If the vendor requires cloud object storage:

# AWS S3 Storage (Optional)
# AWS_S3_BUCKET="vendor-spanqc-diagrams"
# AWS_REGION="us-east-1"

# Azure Blob Storage (Optional)
# AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"

# ------------------------------------------------------------------------------
# 5. ENTERPRISE SINGLE SIGN-ON (OPTIONAL)
# ------------------------------------------------------------------------------
# Google Workspace OAuth SSO (Optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# Initial admin emails (comma-separated, auto-granted admin privileges upon signup)
ADMIN_EMAILS="admin@vendorcompany.com"
