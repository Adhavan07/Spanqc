{
  "name": "spanqc-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:core": "cd spanqc_core && python3 -m uvicorn app:app --host 127.0.0.1 --port 8000 --reload",
    "dev:all": "bash -c 'trap \"kill 0\" EXIT; npm run dev:core & npm run dev'",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=\"file:./test.db?connection_limit=1&socket_timeout=30\" tsx tests/auth-security.test.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "google-auth-library": "^10.9.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.2",
    "prisma": "^6.19.3",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
