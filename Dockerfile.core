# ==============================================================================
# Production Dockerfile for SpanQC Core (FastAPI + Rule Engine + Claude Vision)
# ==============================================================================

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8000

WORKDIR /app

# Install curl for docker healthcheck and minimal runtime dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Create unprivileged system user
RUN groupadd -g 1002 spanqc && \
    useradd -u 1002 -g spanqc -s /bin/bash -m spanqc

# Copy and install python dependencies
COPY spanqc_core/requirements.txt ./requirements.txt
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Copy spanqc_core source code, prompts, and demo files
COPY spanqc_core/spanqc_core ./spanqc_core
COPY spanqc_core/prompts ./prompts

RUN chown -R spanqc:spanqc /app

USER spanqc

EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://127.0.0.1:8000/health || exit 1

CMD ["python3", "-m", "uvicorn", "spanqc_core.api:app", "--host", "0.0.0.0", "--port", "8000"]
